NEXT_PUBLIC_SITE_URL=https://ancapaglobal.com

# Contact form email delivery (SMTP) — use the ainguane@ancapaglobal.com
# mailbox credentials from the Hostinger email panel.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=ainguane@ancapaglobal.com
SMTP_PASS=
# Optional: recipient address, defaults to ainguane@ancapaglobal.com
CONTACT_TO_EMAIL=ainguane@ancapaglobal.com

# Optional: also forward inquiries to HubSpot, Zapier, Make, or a custom CRM webhook.
CONTACT_WEBHOOK_URL=

# Optional: Google Analytics 4 measurement ID (looks like G-XXXXXXXXXX). Leave empty for no analytics and no cookie banner.
# Must be set before the build/deploy because NEXT_PUBLIC_ values are baked in at build time.
NEXT_PUBLIC_GA_ID=
