NEXT_PUBLIC_SITE_URL=https://ancapaglobal.com

# Contact form email delivery (SMTP) — use the ainguane@ancapaglobal.com
# mailbox credentials from the Hostinger email panel.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=ainguane@ancapaglobal.com
