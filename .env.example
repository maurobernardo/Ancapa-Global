NEXT_PUBLIC_SITE_URL=https://ancapaglobal.com

# Contact form email delivery (SMTP) — use the ainguane@ancapaglobal.com
# mailbox credentials from the Hostinger email panel.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=ainguane@ancapaglobal.com
SMTP_PASS=
# Optional: recipient address, defaults to ainguane@ancapaglobal.com
CONTACT_TO_EMAIL=ainguane@ancapaglobal.com

# Optional: also forward inquiries to HubSpot, Zapier, Make, or a custom CRM webhook.
CONTACT_WEBHOOK_URL=

# Optional: Umami analytics (cookieless, no consent banner needed). Leave empty to disable.
# Website ID is the UUID from your Umami dashboard. Set it before the build/deploy (NEXT_PUBLIC_ values are baked in at build time).
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Only if you self-host Umami (default: https://cloud.umami.is/script.js)
NEXT_PUBLIC_UMAMI_SRC=
