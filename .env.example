# Optional: recipient address, defaults to ainguane@ancapaglobal.com
CONTACT_TO_EMAIL=ainguane@ancapaglobal.com

# Optional: also forward inquiries to HubSpot, Zapier, Make, or a custom CRM webhook.
CONTACT_WEBHOOK_URL=
